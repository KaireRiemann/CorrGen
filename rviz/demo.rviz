Panels:
  - Class: rviz/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 30; 30; 35
    Fixed Frame: map
    Frame Rate: 30
  Displays:
    - Class: rviz/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 30
    - Class: rviz/PointCloud2
      Name: Map
      Enabled: true
      Topic: /corrgen_demo/map
      Size (m): 0.08
      Style: Points
      Color Transformer: FlatColor
      Color: 150; 150; 150
    - Class: rviz/Path
      Name: Astar
      Enabled: true
      Topic: /corrgen_demo/astar_path
      Color: 255; 170; 0
      Line Style: Lines
      Line Width: 0.03
    - Class: rviz/Path
      Name: Reference
      Enabled: true
      Topic: /corrgen_demo/reference_path
      Color: 0; 230; 255
      Line Style: Lines
      Line Width: 0.05
    - Class: rviz/MarkerArray
      Name: Corridor
      Enabled: true
      Marker Topic: /corrgen_demo/corridor
    - Class: rviz/MarkerArray
      Name: Start Goal and Status
      Enabled: true
      Marker Topic: /corrgen_demo/selection
  Enabled: true
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/SetGoal
      Topic: /move_base_simple/goal
    - Class: rviz/SetInitialPose
      Topic: /initialpose
    - Class: rviz/PublishPoint
      Single click: true
      Topic: /clicked_point
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 30
      Focal Point: {X: 10, Y: 5, Z: 1.5}
      Pitch: 0.9
      Yaw: 4.7

Window Geometry:
  Width: 1400
  Height: 900
  X: 80
  Y: 80
